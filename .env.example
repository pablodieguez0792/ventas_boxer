# Backend environment variables
# Copy this file to `.env` and set your secrets locally. `.env` is already gitignored.

# OpenAI API key for chatbot intelligence (optional). If not set, the bot replies with local fallback.
OPENAI_API_KEY=

# Promotive/SpecParts API Configuration
PROMOTIVE_CLIENT_ID=your_client_id_here
PROMOTIVE_CLIENT_SECRET=your_client_secret_here
PROMOTIVE_BASE_URL=https://external-api.specparts.ai
PROMOTIVE_AUTH_URL=https://auth.specparts.ai/oauth

# You can add other config here as needed

# Token de la API de Boxer Gestion (cuenta demo / cuenta conectada)
BOXER_DEMO_TOKEN=

TIENDANUBE_CLIENT_SECRET=
